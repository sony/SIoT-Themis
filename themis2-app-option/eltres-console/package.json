{
  "name": "eltres-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ext .ts,.js,.tsx . --ignore-path .gitignore",
    "lint:fix": "eslint --fix --ext .ts,.js,.tsx . --ignore-path .gitignore",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@emotion/cache": "^11.13.1",
    "@emotion/react": "^11.13.3",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^6.1.2",
    "@mui/material-nextjs": "^6.1.2",
    "next": "^15.0.0",
    "next-auth": "^4.24.8",
    "next-intl": "^4.0.0",
